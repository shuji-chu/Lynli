<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 顶部：套餐名 + 流量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/subscriptionName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="套餐"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"/>

                <TextView
                    android:id="@+id/subscriptionTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#64748B"/>
            </LinearLayout>

            <TextView
                android:id="@+id/subscriptionDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#64748B"/>

            <!-- 价格横排 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 1个月 -->
                    <LinearLayout
                        android:id="@+id/grouponemohtthtest"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_plan_price_box">

                        <TextView
                            android:id="@+id/onemohtthtest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1个月"
                            android:textSize="12sp"
                            android:textColor="#64748B"/>

                        <TextView
                            android:id="@+id/onemonthprice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#2E5BFF"/>

                        <TextView
                            android:id="@+id/onemonthpriceday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.00元/天"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"/>
                    </LinearLayout>

                    <!-- 季度 -->
                    <LinearLayout
                        android:id="@+id/groupquitytthtest"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_plan_price_box">

                        <TextView
                            android:id="@+id/onequietythtest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="季度"
                            android:textSize="12sp"
                            android:textColor="#64748B"/>

                        <TextView
                            android:id="@+id/onequietyprice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#2E5BFF"/>

                        <TextView
                            android:id="@+id/onequietypriceday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.00元/天"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"/>
                    </LinearLayout>

                    <!-- 半年 -->
                    <LinearLayout
                        android:id="@+id/grouphelfyear"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_plan_price_box">

                        <TextView
                            android:id="@+id/helfyearthtest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="半年"
                            android:textSize="12sp"
                            android:textColor="#64748B"/>

                        <TextView
                            android:id="@+id/helfyearprice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#2E5BFF"/>

                        <TextView
                            android:id="@+id/helfyearpriceday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.00元/天"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"/>
                    </LinearLayout>

                    <!-- 1年 -->
                    <LinearLayout
                        android:id="@+id/grouponeyear"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_plan_price_box">

                        <TextView
                            android:id="@+id/oneyearthtest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1年"
                            android:textSize="12sp"
                            android:textColor="#64748B"/>

                        <TextView
                            android:id="@+id/oneyearprice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#2E5BFF"/>

                        <TextView
                            android:id="@+id/oneyearpriceday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.00元/天"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>

<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="80dp"
                android:paddingBottom="40dp">

                <ImageView
                    android:id="@+id/login_logoImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/appstore"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/login_welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="欢迎使用 Lynli"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/login_subText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全球网络加速服务，注册即享免费试用"
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="36dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_login_card"
                    android:padding="24dp"
                    android:elevation="8dp">

                    <EditText
                        android:id="@+id/login_emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="请输入邮箱地址"
                        android:inputType="textEmailAddress"
                        android:drawableStart="@drawable/mail_24px"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/icon_muted"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/icon_muted"
                        android:background="@drawable/rounded_edittext"
                        android:layout_marginBottom="12dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/login_passwordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="请输入密码"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:drawableStart="@drawable/lock_24px"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/icon_muted"
                            android:paddingStart="14dp"
                            android:paddingEnd="44dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/icon_muted"
                            android:background="@drawable/rounded_edittext" />

                        <ImageView
                            android:id="@+id/togglePasswordVisibility"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="end|center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility_off_24px" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/login_forgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="忘记密码？"
                        android:textSize="13sp"
                        android:textColor="@color/primary_light"
                        android:visibility="gone"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_gravity="end"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <CheckBox
                            android:id="@+id/login_agreementCheckBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="同意"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:buttonTint="@color/primary_light" />

                        <Button
                            android:id="@+id/login_privacy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/primary_light"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="《隐私政策》及《用户协议》"
                            android:background="?android:attr/selectableItemBackground" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/login_loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="登 录"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary_light"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/login_register"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="没有账户？注册"
                        android:background="?android:attr/selectableItemBackground"
                        android:textSize="14sp"
                        android:textColor="@color/primary_light"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/login_footerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="© 2024 · Lynli"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="32dp"
                    android:gravity="center" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</layout>
